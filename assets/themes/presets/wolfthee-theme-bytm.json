{
  "id": "wolfthee-theme-bytm",
  "name": "Better-YTM",
  "creators": ["WolftheE"],
  "blurb": "Roomy, bouncy lyrics where the sung line is large and every other line shrinks, white highlights on black, a bright reactive background and a floating player bar.",
  "source": "Better Lyrics: WolftheE/better-ytm 5.0.0",
  "accent": "#ffffff",
  "background": {
    "mode": "kawarp",
    "solid": "#030303",
    "intensity": 1.0,
    "saturation": 1.1,
    "speed": 3.33,
    "np_dim": 1.0,
    "reactive": 2.0,
    "audio_speed": 4.0
  },
  "lyrics": {
    "weight": "semibold",
    "font_rem": [[0, 4.25]],
    "line_height": 1.33,
    "line_padding_rem": 2.76,
    "padding_inline": [12.75, 12.75],
    "past_dim_alpha": 1.0,
    "past_color": "white",
    "rest_scale": 0.58,
    "active_scale": 1.0,
    "scale_secs": 0.3,
    "wobble_secs": 1.75,
    "letter_wave": { "secs": 1.5, "emphasis": 1.05 },
    "word_bounce": { "lift": 0.05, "scale": 1.0, "secs": 1.75, "settle": 0.085 },
    "glow_alpha": 0.1,
    "long_glow_alpha": 1.0,
    "background_em": 0.65,
    "instrumental": "dots"
  },
  "cover": {
    "radius": 6,
    "shadow": 0.25,
    "shadow_blur": 16,
    "shadow_offset": 5
  },
  "now_playing": { "tabs": "strip" },
  "chrome": {
    "radius": 6,
    "player_bar": "floating",
    "bar_height": 90,
    "bar_radius": 6,
    "bar_color": "#050505",
    "bar_margin": [16, 8],
    "progress_px": 5,
    "progress_color": "white",
    "progress_radius": 100
  },
  "app": {
    "page_bg": "solid",
    "sidebar": "solid",
    "sidebar_border": 0.1,
    "bar_alpha": 0.7,
    "bar_border": true,
    "nav": "inverse",
    "chip_radius": 6,
    "card_radius": 6,
    "thumb_radius": 6,
    "panel_radius": 6,
    "menu_radius": 6,
    "menu_border": 0.1,
    "menu_color": "#101010",
    "text_dim": "#bcbcbc",
    "search_radius": 6,
    "search_alpha": 0.1,
    "frost": true
  }
}
