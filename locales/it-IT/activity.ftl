### Status messages and notifications.

status-link-copied = Link copiato
status-starting-playback = Avvio della riproduzione…
status-playing-next = Sarà riprodotto dopo
status-added-queue = Aggiunto alla coda
status-removed-queue = Rimosso dalla coda
status-cleared-queue = Coda svuotata
status-removed-playlist = Rimosso dalla playlist
status-not-added-duplicates =
    { $count ->
        [one] Non aggiunto: è già in «{ $title }»
       *[other] Niente aggiunto: alcuni di questi brani sono già in «{ $title }»
    }
status-playlist-deleted = Playlist eliminata
status-added-liked = Aggiunto ai brani che ti piacciono
status-sign-in-like = Accedi per mettere «Mi piace»
status-sign-in-rate = Accedi per valutare i brani
status-sign-in-edit = Accedi per modificare le playlist
status-sign-in-create = Accedi per creare playlist
status-sign-in-save = Accedi per salvare nella raccolta
status-sign-in-subscribe = Accedi per iscriverti
status-sign-in-upload = Accedi per caricare musica
status-upload-formats = YouTube Music accetta solo file MP3, M4A, FLAC, OGG e WMA
status-uploading = Caricamento brani: { $count }…
status-liking = Aggiunta di «Mi piace»: { $count }…
status-downloading = Download di «{ $title }»
