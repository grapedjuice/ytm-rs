{
  "id": "minimalism-music",
  "name": "Minimalism Music",
  "creators": [
    "notacoderlols"
  ],
  "blurb": "An Apple Music-inspired look: very large SF Pro lyrics, sung lines that vanish, a flat 75% for the lines ahead and a still, dimmed blurred cover behind.",
  "source": "Better Lyrics: notacoderlols/Minimalisic-Music 1.0.0",
  "background": {
    "mode": "cover_static",
    "np_dim": 0.5
  },
  "lyrics": {
    "weight": "semibold",
    "font": "SF Pro Display",
    "font_rem": [
      [
        0,
        3.0
      ],
      [
        1400,
        4.0
      ],
      [
        1600,
        5.0
      ],
      [
        1800,
        6.0
      ]
    ],
    "line_padding_rem": 0.5,
    "padding_inline": [
      20,
      10
    ],
    "past": [
      [
        0.0,
        0.0
      ]
    ],
    "upcoming": [
      [
        0.75,
        0.0
      ]
    ],
    "opacity_transition": {
      "frac": 0.5,
      "secs": 0.0,
      "delay": 0.166
    },
    "blur_transition": {
      "frac": 0.3333,
      "secs": 0.0,
      "delay": 0.4
    },
    "hover_reveal": true,
    "hover_scale": 1.01,
    "letter_wave": {
      "on": false
    },
    "wobble": false,
    "glow_alpha": 0.0,
    "long_glow_alpha": 1.0,
    "background_em": 1.0,
    "background_alpha": 0.75,
    "background_weight": "bold",
    "romanization_rem": 1.6,
    "romanization_pill": false,
    "romanization_weight": "bold",
    "translation_rem": 1.6,
    "translation_weight": "bold",
    "instrumental": "dots",
    "instrumental_breathe": [
      1,
      1.14,
      3
    ],
    "line_fade_secs": 2.25,
    "padding_top": 10,
    "dot_em": [0.36, 0.32],
    "decor_em": 0.4
  },
  "cover": {
    "radius": 10,
    "size_vh": 0.5,
    "outline": [
      1,
      0.1
    ],
    "fullscreen": {
      "size_vh": 0.6,
      "enter": [0.9, 1.1],
      "leave": [1.08, 0.9],
      "enter_shift_vh": 0.015,
      "leave_shift_vh": -0.01,
      "settle_fade": 0.35
    },
    "open_scale": 0.9,
    "open_secs": 0.9,
    "open_fade": true
  },
  "now_playing": {
    "switch": {
      "back": 0,
      "selected": 0.1,
      "plain": true
    },
    "panel_frac": [
      0.4,
      0.4
    ],
    "no_lyrics_text": "You'll have to guess the lyrics for this one.",
    "no_lyrics": {
      "rem": 5,
      "center_after": 1.4
    }
  },
  "chrome": {
    "hide_volume": true,
    "progress_color": "white",
    "progress_radius": 100,
    "bar_layout": "song_left",
    "byline_marquee": true,
    "marquee_secs": 7
  },
  "app": {
    "font": "SF Pro Display",
    "all_bold": true,
    "hide_scrollbars": true
  }
}
