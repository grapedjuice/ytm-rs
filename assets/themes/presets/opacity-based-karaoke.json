{
  "id": "opacity-based-karaoke",
  "name": "Opacity Based Karaoke",
  "creators": [
    "semicolonhope"
  ],
  "blurb": "Only the line being sung is visible: each word floats up and appears as it's sung over a dim full-cover backdrop.",
  "source": "Better Lyrics: ramansg/Max-Performance-BlyricsTheme 3.1.29",
  "background": {
    "mode": "cover_fullbleed",
    "np_dim": 0.22
  },
  "accent": "#ffffff",
  "lyrics": {
    "font": "Google Sans Flex",
    "weight": "semibold",
    "font_rem": [
      [
        0,
        3
      ]
    ],
    "fullscreen_scale": 1.4,
    "line_height": 1.5,
    "line_padding_rem": 1.35,
    "anchor": 0.4,
    "rest_scale": 1,
    "active_scale": 1,
    "wobble": false,
    "letter_wave": {
      "on": false
    },
    "glow_alpha": 0,
    "long_glow_alpha": 0,
    "romanization_rem": 1.5,
    "romanization_alpha": 0.65,
    "romanization_pill": false,
    "translation_rem": 2,
    "translation_alpha": 0.82,
    "fill": "word",
    "dim_alpha": 0,
    "sung_fade": [
      0.7,
      0.2
    ],
    "word_bounce": {
      "lift": 0.15,
      "scale": 1.035,
      "secs": 0.7,
      "settle": 0
    },
    "past": [
      [
        0,
        0
      ]
    ],
    "upcoming": [
      [
        0,
        0
      ]
    ],
    "opacity_transition": {
      "frac": 0,
      "secs": 0.4,
      "delay": 0
    },
    "scroll_secs": 0.8,
    "scroll_ease": [
      0.165,
      0.84,
      0.44,
      1
    ],
    "scroll_offset": 0.4,
    "reveal_dim_alpha": 0.7
  },
  "cover": {
    "radius_pct": 0.08,
    "outline": [
      1,
      0.1
    ]
  },
  "chrome": {
    "play_button": "ghost",
    "progress_color": "white",
    "progress_thumb": false
  },
  "app": {
    "font": "Google Sans Flex",
    "page_bg": "solid",
    "bar_alpha": 0,
    "chip": "ghost",
    "search_radius": 20,
    "search_alpha": 0.1,
    "search_border": 0.1,
    "menu_radius": 13.92,
    "text_dim": "#a3a3a3"
  }
}
