discord-app-name = Nazwa aplikacji
discord-app-name-desc = Zastępuje „{ $name }” w Discordzie. Pozostaw puste, aby zachować oryginał.
discord-card = Karta Discorda
discord-card-note = Link obok wiersza otwiera odpowiedni element w YouTube Music.
discord-line-one = Wiersz 1
discord-line-two = Wiersz 2
discord-line-three = Wiersz 3
