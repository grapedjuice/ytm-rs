status-unlike-failed = Like intrekken mislukt
status-explicit-skipped = Expliciet nummer overgeslagen
status-no-clean-tracks = Geen nummers zonder expliciete inhoud
status-signed-in = Ingelogd
status-signed-out = Uitgelogd
status-switched-channel = Gewisseld naar { $name }
status-skipped-track = ‘{ $title }’ overgeslagen: { $reason }
status-track-failed = ‘{ $title }’ kan niet worden afgespeeld: { $reason }
status-track-from-device = ‘{ $title }’ is overgenomen van je andere apparaat. Druk op Afspelen om verder te gaan.
status-track-disconnected = De verbinding viel weg tijdens ‘{ $title }’. Druk op Afspelen om verder te gaan.
