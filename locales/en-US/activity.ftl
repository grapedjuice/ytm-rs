### Status messages and notifications.

status-link-copied = Link copied
status-starting-playback = Starting playback…
status-playing-next = Playing next
status-added-queue = Added to queue
status-removed-queue = Removed from queue
status-cleared-queue = Queue cleared
status-removed-playlist = Removed from playlist
status-playlist-deleted = Playlist deleted
status-added-liked = Added to Liked Music
status-sign-in-like = Sign in to like songs
status-sign-in-rate = Sign in to rate songs
status-sign-in-edit = Sign in to edit playlists
status-sign-in-create = Sign in to create playlists
status-sign-in-save = Sign in to save to library
status-sign-in-subscribe = Sign in to subscribe
status-sign-in-upload = Sign in to upload music
status-upload-formats = YouTube Music only takes MP3, M4A, FLAC, OGG and WMA files
status-uploading = Uploading tracks: { $count }…
status-liking = Liking tracks: { $count }…
status-downloading = Downloading “{ $title }”
status-downloaded = Downloaded “{ $title }”
status-playlist-loading = This playlist is still loading. Try again in a moment.
status-playlist-reload = YouTube Music didn't say where these songs are in the playlist. Reload it and try again.
status-queue-changed = The queue changed since, so that can't be undone
status-video-unavailable = This video can't be shown
status-upload-deleted = Deleted from your uploads
status-disliked = Disliked song
status-dislike-failed = Couldn't dislike song
status-undisliked = Dislike removed
status-undislike-failed = Couldn't remove dislike
status-unlike-failed = Couldn't remove like
status-explicit-skipped = Skipped an explicit song
status-no-clean-tracks = Nothing to play that isn't explicit
status-signed-in = Signed in
status-signed-out = Signed out
status-switched-channel = Switched to { $name }
status-skipped-track = Skipped “{ $title }”: { $reason }
status-track-failed = Can't play “{ $title }”: { $reason }
status-track-from-device = Picked up “{ $title }” from your other device. Press play to carry on.
status-track-disconnected = Lost the connection while playing “{ $title }”. Press play to continue.
