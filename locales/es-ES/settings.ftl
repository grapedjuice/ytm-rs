settings-lyrics-timing = Sincronización de las letras
settings-timing-offset = Desfase
settings-timing-offset-desc = Retrasa (+) o adelanta (−) todas las letras.
settings-word-synced-trim = Ajuste por palabra
settings-word-synced-trim-desc = Desfase adicional para letras sincronizadas por sílabas o palabras.
settings-line-synced-trim = Ajuste por verso
