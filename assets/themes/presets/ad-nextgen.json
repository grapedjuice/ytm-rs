{
  "id": "ad-nextgen",
  "name": "AppleTify",
  "creators": [
    "a-dogann"
  ],
  "blurb": "Minimal dark skin mixing Apple Music and Spotify: right-leaning bold lyrics with a depth blur, a dark blurred still cover backdrop on now playing, a floating pill player bar and a red accent.",
  "source": "Better Lyrics: a-dogann/-ADNEXTGEN-THEME 1.0.1",
  "accent": "#fa243c",
  "background": {
    "mode": "cover_static",
    "solid": "#000000",
    "saturation": 0.8,
    "np_dim": 0.45
  },
  "lyrics": {
    "font": "SF Pro Display",
    "agent_align": "only_v1_left",
    "font_rem": [
      [
        0,
        4.2
      ]
    ],
    "dim_alpha": 0.2,
    "past": [
      [
        0.0,
        4.0
      ]
    ],
    "upcoming": [
      [
        1.0,
        1.5
      ],
      [
        1.0,
        3.0
      ],
      [
        1.0,
        5.0
      ],
      [
        1.0,
        8.0
      ]
    ],
    "opacity_transition": {
      "secs": 0.4
    },
    "blur_transition": {
      "secs": 0.4
    },
    "wobble": false,
