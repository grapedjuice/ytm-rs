### Status messages and notifications.

status-link-copied = Lien copié
status-starting-playback = Démarrage de la lecture…
status-playing-next = Sera lu ensuite
status-added-queue = Ajouté à la file d’attente
status-removed-queue = Retiré de la file d’attente
status-cleared-queue = File d’attente vidée
status-removed-playlist = Retiré de la playlist
status-not-added-duplicates =
    { $count ->
        [one] Non ajouté : déjà dans « { $title } »
       *[other] Rien n’a été ajouté : certains de ces titres sont déjà dans « { $title } »
    }
status-playlist-deleted = Playlist supprimée
status-added-liked = Ajouté aux titres aimés
status-sign-in-like = Connectez-vous pour aimer des titres
status-sign-in-rate = Connectez-vous pour évaluer des titres
status-sign-in-edit = Connectez-vous pour modifier vos playlists
status-sign-in-create = Connectez-vous pour créer des playlists
status-sign-in-save = Connectez-vous pour enregistrer dans la bibliothèque
status-sign-in-subscribe = Connectez-vous pour vous abonner
status-sign-in-upload = Connectez-vous pour importer de la musique
status-upload-formats = YouTube Music accepte uniquement les fichiers MP3, M4A, FLAC, OGG et WMA
status-uploading = Importation en cours : { $count }
status-liking = Ajout de « J’aime » : { $count }…
status-downloading = Téléchargement de « { $title } »
status-downloaded = « { $title } » téléchargé
