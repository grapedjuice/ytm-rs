{
  "id": "thejosueps-equal-tweaks-id",
  "name": "EqualTweaks",
  "creators": [
    "thejosuep"
  ],
  "blurb": "The base look with frosted-glass bars and menus, rounder covers and thumbnails, a thin outline on the cover, and larger lyrics in full screen.",
  "source": "Better Lyrics: TheJosuep/better-lyrics-equal-tweaks-theme 1.2.0",
  "background": {
    "mode": "cover_static"
  },
  "lyrics": {
    "fullscreen_scale": 1.333
  },
  "cover": {
    "radius": 25,
    "shadow": 0.15,
    "shadow_blur": 5,
    "shadow_offset": 3,
    "outline": [
      1,
      0.5
    ],
    "fullscreen": {
      "radius": 0,
      "no_outline": true
    }
  },
  "now_playing": {
    "video_radius": 13,
    "switch": {
      "stroke": 0.2
    }
  },
  "app": {
    "sidebar": "glass",
    "sidebar_alpha": 0.5,
    "bar_alpha": 0.5,
    "chip_radius": 12,
    "card_radius": 15,
    "thumb_radius": 8,
    "panel_radius": 10,
    "menu_radius": 15,
    "menu_border": 0.2,
    "search_radius": 13,
    "hide_scrollbars": true,
    "frost": true,
    "nav_item": {
      "hover": 0.07
    },
    "search_look": {
      "drop_radius": 13
    },
    "menu_color": "#000000",
    "menu_look": {
      "alpha": 0.85
    },
    "chip_look": {
      "fill": 0.05,
      "hover": 0.18
    },
    "card_look": {
      "play_alpha": 0.75
    },
    "row_look": {
      "hover": 0.03,
      "radius": 10
    },
    "strap_alpha": 0.75
  }
}
