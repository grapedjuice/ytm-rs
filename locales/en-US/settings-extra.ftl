### Options and descriptions used in Settings.

extra-renderer-desc = Use { $api } (wgpu) instead of OpenGL. It takes about three times the memory and is useful if OpenGL draws incorrectly. Falls back to OpenGL if { $api } cannot start.
extra-channel-release-desc = Stable releases are ready for everyday listening. Nightly builds are experimental and may break.
extra-theme-accessible-name = Theme: { $name }
extra-built-in = Built in
extra-theme-author = by { $name }
extra-theme-source = From { $source }
extra-system-shortcuts = System-wide shortcuts
extra-system-shortcuts-desc = These work while another app is in front, or the window is minimized or in the tray.
extra-shortcut-failed = Couldn't save that shortcut
extra-shortcut-missing = No key came through. Another app may be using that shortcut, so try a different one.
extra-shortcut-hold = Hold { $keys } as well, so typing isn't taken from other apps.
extra-shortcut-occupied = Already assigned to “{ $command }”.
extra-shortcut-press = Press the new shortcut.
extra-shortcut-wait = Waiting for a key
extra-shortcuts-wayland = Wayland doesn't let apps watch for keys in the background. Use your desktop's media shortcuts to control ytm-rs.
extra-shortcuts-blocked = The system wouldn't let ytm-rs set up shortcuts.
extra-unavailable-here = Not available here
extra-shortcut-app-conflict = Another app may be using this
extra-reset = Reset
