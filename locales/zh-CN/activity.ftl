### Status messages and notifications.

status-link-copied = 链接已复制
status-starting-playback = 开始播放...
status-playing-next = 下一个播放
status-added-queue = 已添加到队列
status-removed-queue = 已从队列中删除
status-cleared-queue = 队列已清除
status-removed-playlist = 已从播放列表中删除
status-playlist-deleted = 播放列表已删除
status-added-liked = 已添加到喜欢的音乐
status-sign-in-like = 登录以喜欢歌曲
status-sign-in-rate = 登录以对歌曲进行评分
status-sign-in-edit = 登录以编辑播放列表
status-sign-in-create = 登录以创建播放列表
status-sign-in-save = 登录以保存到库
status-sign-in-subscribe = 登录订阅
status-sign-in-upload = 登录以上传音乐
status-upload-formats = YouTube Music 只接受 MP3、M4A、FLAC、OGG 和 WMA 文件
status-uploading = 上传曲目：{ $count }…
status-liking = 喜欢的曲目：{ $count }…
status-downloading = 正在下载“{ $title }”
status-downloaded = 已下载“{ $title }”
status-playlist-loading = 该播放列表仍在加载中。稍后再试一次。
