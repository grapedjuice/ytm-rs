status-unlike-failed = Impossibile rimuovere «Mi piace»
status-explicit-skipped = Brano esplicito saltato
status-no-clean-tracks = Nessun brano senza contenuti espliciti
status-signed-in = Accesso effettuato
status-signed-out = Disconnesso
status-switched-channel = Passaggio a { $name }
status-skipped-track = «{ $title }» saltato: { $reason }
status-track-failed = Impossibile riprodurre «{ $title }»: { $reason }
status-track-from-device = «{ $title }» ripreso dall’altro dispositivo. Premi Riproduci per continuare.
status-track-disconnected = Connessione persa durante «{ $title }». Premi Riproduci per continuare.
