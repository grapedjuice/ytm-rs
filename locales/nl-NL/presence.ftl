discord-card = Discord-kaart
discord-card-note = De link naast een regel opent het bijbehorende item op YouTube Music.
discord-line-one = Regel 1
discord-line-two = Regel 2
discord-line-three = Regel 3
discord-line-one-desc = De vetgedrukte regel onder de kop.
discord-line-two-desc = De regel eronder.
discord-line-three-desc = De laatste regel verschijnt ook als je de hoes aanwijst. Vereist een hoes.
discord-clickable = Klikbaar: { $label }
discord-album-art = Albumhoes
