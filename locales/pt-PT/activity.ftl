### Status messages and notifications.

status-link-copied = Ligação copiado
status-starting-playback = A iniciar reprodução…
status-playing-next = Vai tocar a seguir
status-added-queue = Adicionado à fila
status-removed-queue = Removido da fila
status-cleared-queue = Fila limpa
status-removed-playlist = Removido da lista de reprodução
status-not-added-duplicates =
    { $count ->
        [one] Não adicionada: já está em «{ $title }»
       *[other] Nada foi adicionado: algumas destas músicas já estão em «{ $title }»
    }
status-playlist-deleted = Lista de reprodução eliminada
status-added-liked = Adicionado às músicas de que gosto
status-sign-in-like = Entre para marcar «Gosto»
status-sign-in-rate = Entre para avaliar faixas
status-sign-in-edit = Entre para editar listas de reprodução
status-sign-in-create = Entre para criar listas de reprodução
status-sign-in-save = Entre para guardar na biblioteca
status-sign-in-subscribe = Entre para se inscrever
status-sign-in-upload = Entre para enviar músicas
status-upload-formats = O YouTube Music só aceita MP3, M4A, FLAC, OGG e WMA
status-uploading = A enviar faixas: { $count }…
status-liking = A marcar «Gosto» em músicas: { $count }…
status-downloading = A transferir «{ $title }»
status-downloaded = «{ $title }» transferida
status-playlist-loading = Esta lista de reprodução ainda está a carregar. Tente novamente daqui a pouco.
status-playlist-reload = O YouTube Music não informou a posição das faixas. Recarregue a lista de reprodução e tente de novo.
status-queue-changed = A fila mudou. Não é possível desfazer.
status-video-unavailable = Não é possível exibir este vídeo
status-upload-deleted = Excluído dos seus uploads
status-disliked = «Não gosto» marcado
status-dislike-failed = Não foi possível marcar «Não gosto»
status-undisliked = «Não gosto» removido
status-undislike-failed = Não foi possível remover «Não gosto»
status-unlike-failed = Não foi possível remover o «Gosto»
status-explicit-skipped = Faixa explícita pulada
status-no-clean-tracks = Não há faixas sem conteúdo explícito
status-signed-in = Sessão iniciada
status-signed-out = Sessão encerrada
status-switched-channel = Alterado para { $name }
status-skipped-track = «{ $title }» foi pulada: { $reason }
status-track-failed = Não foi possível tocar «{ $title }»: { $reason }
status-track-from-device = «{ $title }» retomada de outro dispositivo. Pressione Reproduzir para continuar.
status-track-disconnected = A ligação caiu ao tocar «{ $title }». Pressione Reproduzir para continuar.
