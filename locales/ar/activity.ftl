### Status messages and notifications.

status-link-copied = تم نسخ الرابط
status-starting-playback = جارٍ بدء التشغيل…
status-playing-next = التشغيل التالي
status-added-queue = تمت الإضافة إلى قائمة الانتظار
status-removed-queue = تمت إزالته من قائمة الانتظار
status-cleared-queue = تم مسح قائمة الانتظار
status-removed-playlist = تمت الإزالة من قائمة التشغيل
status-not-added-duplicates =
    { $count ->
        [zero] لم تُضف أي أغنية: بعضها موجود بالفعل في «{ $title }»
        [one] لم تُضف: إنها موجودة بالفعل في «{ $title }»
        [two] لم تُضف أي أغنية: بعضها موجود بالفعل في «{ $title }»
        [few] لم تُضف أي أغنية: بعضها موجود بالفعل في «{ $title }»
        [many] لم تُضف أي أغنية: بعضها موجود بالفعل في «{ $title }»
       *[other] لم تُضف أي أغنية: بعضها موجود بالفعل في «{ $title }»
    }
status-playlist-deleted = تم حذف قائمة التشغيل
status-added-liked = تمت الإضافة إلى الأغاني التي أعجبتني
status-sign-in-like = سجّل الدخول للإعجاب بالأغاني
status-sign-in-rate = سجّل الدخول لتقييم الأغاني
status-sign-in-edit = سجّل الدخول لتعديل قوائم التشغيل
status-sign-in-create = سجّل الدخول لإنشاء قوائم التشغيل
status-sign-in-save = سجّل الدخول للحفظ في المكتبة
status-sign-in-subscribe = سجّل الدخول للاشتراك
status-sign-in-upload = سجّل الدخول لرفع الموسيقى
status-upload-formats = YouTube Music يقبل فقط ملفات MP3، M4A، FLAC، OGG وWMA
status-uploading = جارٍ رفع المقاطع: { $count }…
status-liking = جارٍ الإعجاب بالمقاطع: { $count }…
status-downloading = جارٍ تنزيل «{ $title }»
status-downloaded = تم تنزيل «{ $title }»
status-playlist-loading = لا تزال قائمة التشغيل هذه قيد التحميل. حاول مجدداً بعد قليل.
status-playlist-reload = لم يذكر YouTube Music مكان وجود هذه الأغاني في قائمة التشغيل. أعدتحميلها وحاول مجدداً.
status-queue-changed = تغيرت قائمة الانتظار منذ ذلك الحين، لذا لا يمكن التراجع عن ذلك
status-video-unavailable = لا يمكن عرض هذا الفيديو
status-upload-deleted = تم الحذف من تحميلاتك
status-disliked = لم تعجبني الأغنية
status-dislike-failed = تعذر تسجيل عدم الإعجاب بالأغنية
status-undisliked = تمت إزالة عدم الإعجاب
status-undislike-failed = تعذرت إزالة عدم الإعجاب
status-unlike-failed = تعذرت إزالة الإعجاب
status-explicit-skipped = تخطي أغنية صريحة
status-no-clean-tracks = لا يوجد شيء للتشغيل غير صريح المحتوى
status-signed-in = تم تسجيل الدخول
status-signed-out = تم تسجيل الخروج
status-switched-channel = تم التبديل إلى { $name }
status-skipped-track = تخطي «{ $title }»: { $reason }
status-track-failed = تعذّر تشغيل «{ $title }»: { $reason }
status-track-from-device = تم استئناف «{ $title }» من جهازك الآخر. اضغط على تشغيل للمتابعة.
status-track-disconnected = فُقد الاتصال أثناء تشغيل «{ $title }». اضغط على تشغيل للمتابعة.
