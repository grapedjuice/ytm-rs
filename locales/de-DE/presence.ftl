### App interface.

discord-show-song = Zeigt den aktuellen Titel in deinem Discord-Profil.
discord-show-paused = Bei Pause anzeigen
discord-show-paused-desc = Die Karte bleibt beim Pausieren sichtbar. Discord blendet die Zeit bis zur Fortsetzung aus.
discord-hide-details = Details ausblenden
discord-hide-details-desc = Zeigt nur, dass Musik läuft. Titeldaten, Cover, Zeit und Schaltflächen werden nicht geteilt.
discord-status = Discord-Status
discord-status-text = Statustext
discord-status-text-desc = Wähle die erste Zeile unter deinem Namen in der Mitgliederliste. Die Profilkarte zeigt immer den App-Namen.
discord-app-name = App-Name
discord-app-name-desc = Ersetzt „{ $name }“ in Discord. Leer lassen für den Originalnamen.
discord-card = Discord-Karte
discord-card-note = Der Link neben einer Zeile öffnet den passenden Eintrag auf YouTube Music.
discord-line-one = Zeile 1
discord-line-two = Zeile 2
discord-line-three = Zeile 3
discord-line-one-desc = Die fette Zeile unter der Überschrift.
discord-line-two-desc = Die Zeile darunter.
discord-line-three-desc = Die letzte Zeile, auch beim Zeigen aufs Cover sichtbar. Benötigt ein Cover.
discord-clickable = Anklickbar: { $label }
discord-album-art = Albumcover
discord-album-art-desc = Zeigt das Cover neben dem Titel. Der Link öffnet das Album oder den Titel.
discord-badge = Abzeichen
discord-badge-desc = Kleines Bild auf dem Cover: Interpretenfoto oder App-Symbol.
discord-time = Zeit
discord-time-desc = Zeigt den Wiedergabefortschritt an. Das vollständige Profil zeigt einen Fortschrittsbalken.
discord-buttons = Discord-Schaltflächen
discord-buttons-note = Andere sehen bis zu zwei Schaltflächen. Links erscheinen, wenn verfügbar, und „Gemeinsam hören“ nur während einer Sitzung.
discord-buttons-toggle = Schaltflächen
discord-buttons-desc = Zeigt Schaltflächen unter der Karte, etwa zum Titel auf YouTube Music.
discord-first-button = Erste Schaltfläche
discord-second-button = Zweite Schaltfläche
discord-song-title = Titelname
discord-artist-photo = Interpretenfoto
discord-you = Du
discord-member-list = Mitgliederliste
discord-profile-card = Profilkarte
discord-reset = Discord-Einstellungen zurücksetzen
discord-example = Beispiel
discord-preview-paused = Die Karte ist bei Pause verborgen. Aktiviere „Bei Pause anzeigen“, damit sie sichtbar bleibt.
discord-preview-buttons = Nur andere sehen die Schaltflächen.
discord-listening-to = Hört { $name }
discord-listen-on-youtube = Auf YouTube Music hören
