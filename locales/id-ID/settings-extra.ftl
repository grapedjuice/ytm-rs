### Options and descriptions used in Settings.

extra-renderer-desc = Gunakan { $api } (wgpu) bukan OpenGL. Dibutuhkan sekitar tiga kali memori dan berguna jika OpenGL salah menggambar. Kembali ke OpenGL jika { $api } tidak dapat dimulai.
extra-channel-release-desc = Rilisan stabil siap untuk didengarkan setiap hari. Bangunan malam hari bersifat eksperimental dan mungkin rusak.
extra-theme-accessible-name = Tema: { $name }
extra-built-in = Terpasang
extra-theme-author = oleh { $name }
extra-theme-source = Dari { $source }
extra-system-shortcuts = Pintasan seluruh sistem
extra-system-shortcuts-desc = Ini berfungsi saat aplikasi lain berada di depan, atau jendela diperkecil atau berada di baki.
extra-shortcut-failed = Tidak dapat menyimpan pintasan itu
extra-shortcut-missing = Tidak ada kunci yang masuk. Aplikasi lain mungkin menggunakan pintasan tersebut, jadi cobalah pintasan lain.
extra-shortcut-hold = Tahan juga { $keys }, sehingga pengetikan tidak diambil dari aplikasi lain.
extra-shortcut-occupied = Sudah ditetapkan ke “{ $command }”.
extra-shortcut-press = Tekan pintasan baru.
extra-shortcut-wait = Menunggu kunci
extra-shortcuts-wayland = Wayland tidak mengizinkan aplikasi mengawasi kunci di latar belakang. Gunakan pintasan media desktop Anda untuk mengontrol ytm-rs.
extra-shortcuts-blocked = Sistem tidak mengizinkan ytm-rs mengatur pintasan.
extra-unavailable-here = Tidak tersedia di sini
extra-shortcut-app-conflict = Aplikasi lain mungkin menggunakan ini
extra-reset = Atur Ulang
