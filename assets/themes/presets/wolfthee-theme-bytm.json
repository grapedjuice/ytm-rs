{
  "id": "wolfthee-theme-bytm",
  "name": "Better-YTM",
  "creators": ["WolftheE"],
  "blurb": "Roomy, bouncy lyrics where the sung line is large and every other line shrinks, white highlights on black, a bright reactive background and a floating player bar.",
  "source": "Better Lyrics: WolftheE/better-ytm 5.0.0",
  "accent": "#ffffff",
  "background": {
    "mode": "kawarp",
    "solid": "#030303",
    "intensity": 1.0,
    "saturation": 1.1,
    "speed": 3.33,
    "np_dim": 1.0,
    "reactive": 2.0,
    "audio_speed": 4.0,
    "crossfade_secs": 1.0,
    "beat_threshold": 0.75,
    "auto_dim": 0.3,
    "blur_passes": 6,
    "video_backdrop": true
  },
  "lyrics": {
    "weight": "semibold",
    "font_rem": [[0, 4.25]],
    "line_height": 1.33,
    "line_padding_rem": 2.76,
    "padding_inline": [12.75, 12.75],
    "past_dim_alpha": 1.0,
    "past_color": "white",
    "rest_scale": 0.58,
    "active_scale": 1.0,
    "scale_secs": 0.3,
    "wobble_secs": 1.75,
    "letter_wave": { "secs": 1.5, "emphasis": 1.05 },
    "word_bounce": { "lift": 0.05, "scale": 1.0, "secs": 1.75, "settle": 0.085 },
    "word_shadow": [3, 0.15],
    "word_shadow_unsung": true,
    "background_weight": "medium",
    "edge_fade": [0.07, 0.07],
    "glow_alpha": 0.1,
    "long_glow_alpha": 1.0,
    "background_em": 0.65,
    "instrumental": "dots"
  },
  "cover": {
    "radius": 6,
    "shadow": 0.25,
    "shadow_blur": 16,
    "shadow_offset": 5
  },
  "now_playing": { "tabs": "strip", "tab_content": "icons", "tab_width_frac": 0.5, "cover_controls": true, "cover_buttons": [42, 0.5, 1.2], "cover_play_bare": true, "fullscreen_panel_frac": 0.55 },
  "chrome": {
    "radius": 6,
    "player_bar": "floating",
    "bar_height": 90,
    "bar_radius": 6,
    "bar_color": "#050505",
    "bar_layout": "song_left",
    "thumb_px": 60,
    "thumb_radius": 6,
    "bar_byline_px": 12.5,
    "bar_np_alpha": 0.2,
    "bar_margin": [16, 8],
    "progress_px": 5,
    "progress_color": "white",
    "progress_radius": 100,
    "progress_at": "above_transport",
    "progress_thumb_px": 5,
    "time_at": "under_transport",
    "play_scale": 0.87,
    "bar_border_alpha": 0.1
  },
  "app": {
    "page_bg": "solid",
    "sidebar": "solid",
    "sidebar_border": 0.1,
    "bar_alpha": 0.7,
    "bar_border": true,
    "nav": "inverse",
    "chip_radius": 6,
    "card_radius": 6,
    "thumb_radius": 6,
    "panel_radius": 6,
    "menu_radius": 6,
    "menu_border": 0.1,
    "menu_color": "#101010",
    "menu_look": { "hover": 0.1, "shadow": [3, 15, 0.5], "row_radius": 6, "pop": [0.85, 0.3], "min_px": 305 },
    "search_look": { "drop_radius": 6, "attached": true, "drop_grow": true },
    "nav_item": { "radius": 6, "hover": 0.1, "slide": 4, "press": 0.3, "cover_tint": [0.7, 800] },
    "row_look": { "height": 64, "radius": 6, "hover": 0.1, "current": 0.1, "current_bar": 4, "hover_scale": 1.02 },
    "card_look": { "image_zoom": 0.04, "image_dim": 0.5 },
    "controls": { "button_fill": 0.05, "button_hover": 0.05, "press_fill": 0.3, "shadow": [3, 7, 0.1], "play_hover_scale": 1.1, "spring": true },
    "text_dim": "#bcbcbc",
    "search_radius": 6,
    "search_alpha": 0.1,
    "header_gradient": [0, 1],
    "np_open_secs": 0.5,
    "glass": { "bar": [16, 1, 1] }
  }
}
