### Options and descriptions used in Settings.

extra-renderer-desc = Usa { $api } (wgpu) no lugar de OpenGL. Usa cerca de três vezes mais memória. Experimente se houver problemas na imagem com OpenGL. Se { $api } não iniciar, o aplicativo volta para OpenGL.
extra-channel-release-desc = Versões estáveis estão prontas para uso diário. Compilações noturnas são experimentais e podem falhar.
extra-theme-accessible-name = Tema: { $name }
extra-built-in = Integrado
extra-theme-author = por { $name }
extra-theme-source = De { $source }
extra-system-shortcuts = Atalhos globais
extra-system-shortcuts-desc = Funcionam com outro aplicativo em primeiro plano ou com a janela minimizada ou na bandeja.
extra-shortcut-failed = Não foi possível salvar o atalho
extra-shortcut-missing = Nenhuma tecla detectada. Outro aplicativo talvez use esse atalho. Tente outro.
extra-shortcut-hold = Segure também { $keys } para não interferir na digitação em outros aplicativos.
extra-shortcut-occupied = Já atribuído a “{ $command }”.
extra-shortcut-press = Pressione o novo atalho.
extra-shortcut-wait = Aguardando uma tecla
extra-shortcuts-wayland = Wayland impede detectar teclas em segundo plano. Use os atalhos de mídia do sistema para controlar o ytm-rs.
extra-shortcuts-blocked = O sistema não permitiu configurar os atalhos do ytm-rs.
extra-unavailable-here = Não disponível aqui
extra-shortcut-app-conflict = Outro aplicativo pode estar usando
extra-reset = Redefinir
