{
  "id": "ytm-rs",
  "name": "ytm-rs",
  "creators": ["ytm-rs"],
  "blurb": "The app's own look: animated album-art background, left-aligned karaoke lyrics.",
  "source": "ytm-rs",
  "accent": "cover",
  "background": { "mode": "kawarp", "solid": "#0c0a0e", "np_dim": 0.85, "scrim": 0.3 },
  "lyrics": {
    "rem": 16,
    "opacity_transition": { "secs": 0.195 },
    "blur_transition": { "secs": 0.35 }
  },
  "cover": { "radius": 12, "shadow": 0.55, "shadow_blur": 60 },
  "now_playing": { "title_align": "left", "title_px": 28, "artist_px": 17 },
  "chrome": { "bar_height": 86, "bar_radius": 18, "bar_margin": [14, 14] },
  "app": {
    "page_bg": "same",
    "sidebar": "glass",
    "bar_alpha": 0.55,
    "card_radius": 8,
    "thumb_radius": 5,
    "panel_radius": 14,
    "search_radius": 21,
    "text_dim": "#b2acba"
  }
}
