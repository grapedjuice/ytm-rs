{
  "id": "opacity-based-karaoke",
  "name": "Opacity Based Karaoke",
  "creators": [
    "semicolonhope"
  ],
  "blurb": "Only the line being sung is visible: each word floats up and appears as it's sung over a dim full-cover backdrop.",
  "source": "Better Lyrics: ramansg/Max-Performance-BlyricsTheme 3.1.29",
  "background": {
    "mode": "cover_fullbleed",
    "np_dim": 0.22,
    "crossfade_secs": 2.5,
    "crossfade_delay": 5.0,
    "fullbleed_fade": true
  },
  "accent": "#ffffff",
  "lyrics": {
    "font": "Google Sans Flex",
    "weight": "semibold",
    "font_rem": [
      [
        0,
        3
      ]
    ],
    "fullscreen_scale": 1.4,
    "line_height": 1.5,
    "line_padding_rem": 1.35,
    "anchor": 0.4,
    "rest_scale": 1,
    "active_scale": 1,
    "wobble": false,
    "letter_wave": {
      "on": false
    },
    "glow_alpha": 0,
    "long_glow_alpha": 0,
    "romanization_rem": 1.5,
    "romanization_alpha": 0.65,
    "romanization_pill": false,
    "romanization_weight": "regular",
    "translation_weight": "medium",
    "decor_tracking_em": 0.03,
    "decor_fullscreen_scale": 1.4,
    "translation_rem": 2,
    "translation_alpha": 0.82,
    "fill": "word",
    "dim_alpha": 0,
    "sung_fade": [
      0.7,
      0.2
    ],
    "word_bounce": {
      "lift": 0.15,
      "scale": 1.035,
      "secs": 0.3,
      "settle": 0,
      "dur_ratio": 1,
      "side_em": 0.15
    },
    "past": [
      [
        0,
        0
      ]
    ],
    "upcoming": [
      [
        0,
        0
      ]
    ],
    "opacity_transition": {
      "frac": 0,
      "secs": 0.4,
      "delay": 0
    },
    "scroll_secs": 0.8,
    "scroll_ease": [
      0.165,
      0.84,
      0.44,
      1
    ],
    "scroll_offset": 0.4,
    "reveal_dim_alpha": 0.7,
    "instrumental": "glyph",
    "instrumental_rem": 3.6,
    "instrumental_glow": 0.6,
    "instrumental_breathe": [
      1.0,
      1.05,
      1.5
    ],
    "active_opacity_line_synced": 0.87,
    "active_opacity_transition": {
      "frac": 0,
      "secs": 0.3,
      "delay": 0
    },
    "past_opacity_transition": {
      "frac": 0,
      "secs": 0.3,
      "delay": 0.012
    },
    "hover_box": [
      0.1,
      8
    ],
    "hover_box_line": 0.1,
    "hover_opacity": 1,
    "hover_dim_alpha": 0.95,
    "panel_reveal": true
  },
  "cover": {
    "radius_pct": 0.08,
    "outline": [
      1,
      0.1
    ]
  },
  "chrome": {
    "play_button": "ghost",
    "progress_color": "white",
    "progress_thumb": false,
    "progress_alpha": 0.6,
    "progress_track": 0.1,
    "time_alpha": 0.87,
    "time_weight": "light",
    "icon_alpha": 0.7,
    "bar_cover_alpha": 0.22,
    "tip_fill": "#ffffff",
    "tip_text": "#000000"
  },
  "app": {
    "font": "Google Sans Flex",
    "page_bg": "solid",
    "squircle": true,
    "scrollbar_home_hidden": true,
    "queue_card": true,
    "bar_alpha": 0,
    "chip": "ghost",
    "search_radius": 20,
    "search_alpha": 0.1,
    "search_border": 0.1,
    "menu_radius": 13.92,
    "text_dim": "#a3a3a3",
    "controls": {
      "idle_alpha": 0.7,
      "ghost_outline": 0.12
    },
    "nav_item": {
      "hover": 0.1,
      "selected": 0.1
    },
    "row_look": {
      "radius": 13.92,
      "hover": 0.1,
      "hover_border": 0.15
    },
    "menu_look": {
      "hover": 0.1,
      "row_radius": 13.92
    },
    "search_look": {
      "drop_radius": 20,
      "open_color": "#212121",
      "attached": true,
      "item_radius": 20
    },
    "toast_look": {
      "color": "#212121",
      "alpha": 1,
      "border": [
        0.1,
        1.5
      ],
      "radius": 20.88,
      "secs": 2.5
    },
    "scrollbar": [
      5,
      0.3
    ],
    "immersive_header": 0.6
  },
  "now_playing": {
    "tab_idle_alpha": 0.7,
    "switch": {
      "back": 0.1,
      "selected": 0.15,
      "stroke": 0.1
    }
  }
}
