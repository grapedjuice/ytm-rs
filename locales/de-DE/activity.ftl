### Status messages and notifications.

status-link-copied = Link kopiert
status-starting-playback = Wiedergabe wird gestartet…
status-playing-next = Wird als Nächstes gespielt
status-added-queue = Zur Warteschlange hinzugefügt
status-removed-queue = Aus Warteschlange entfernt
status-cleared-queue = Warteschlange geleert
status-removed-playlist = Aus Playlist entfernt
status-playlist-deleted = Playlist gelöscht
status-added-liked = Zu deinen gelikten Titeln hinzugefügt
status-sign-in-like = Melde dich an, um Titel zu liken
status-sign-in-rate = Melde dich an, um Titel zu bewerten
status-sign-in-edit = Melde dich an, um Playlists zu bearbeiten
status-sign-in-create = Melde dich an, um Playlists zu erstellen
status-sign-in-save = Melde dich an, um in der Mediathek zu speichern
status-sign-in-subscribe = Melde dich an, um zu abonnieren
status-sign-in-upload = Melde dich an, um Musik hochzuladen
status-upload-formats = YouTube Music akzeptiert nur MP3, M4A, FLAC, OGG und WMA
status-uploading = Lade Titel hoch: { $count }…
status-liking = Likes werden gesetzt: { $count }…
status-downloading = „{ $title }“ wird heruntergeladen
status-downloaded = „{ $title }“ heruntergeladen
status-playlist-loading = Diese Playlist wird noch geladen. Versuche es gleich erneut.
status-playlist-reload = YouTube Music hat die Position der Titel nicht geliefert. Lade die Playlist neu und versuche es erneut.
status-queue-changed = Die Warteschlange hat sich geändert. Rückgängig machen ist nicht möglich.
status-video-unavailable = Dieses Video kann nicht angezeigt werden
status-upload-deleted = Aus Uploads gelöscht
status-disliked = „Gefällt mir nicht“ gespeichert
status-dislike-failed = „Gefällt mir nicht“ konnte nicht gespeichert werden
status-undisliked = „Gefällt mir nicht“ entfernt
status-undislike-failed = „Gefällt mir nicht“ konnte nicht entfernt werden
status-unlike-failed = Like konnte nicht entfernt werden
status-explicit-skipped = Expliziter Titel übersprungen
status-no-clean-tracks = Keine Titel ohne explizite Inhalte
status-signed-in = Angemeldet
status-signed-out = Abgemeldet
status-switched-channel = Zu { $name } gewechselt
status-skipped-track = „{ $title }“ übersprungen: { $reason }
status-track-failed = „{ $title }“ kann nicht abgespielt werden: { $reason }
status-track-from-device = „{ $title }“ vom anderen Gerät übernommen. Drücke auf Wiedergabe, um fortzufahren.
status-track-disconnected = Verbindung bei „{ $title }“ verloren. Drücke auf Wiedergabe, um fortzufahren.
