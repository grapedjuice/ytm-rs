status-disliked = Avis négatif enregistré
status-dislike-failed = Impossible d’enregistrer l’avis négatif
status-undisliked = Avis négatif retiré
status-undislike-failed = Impossible de retirer l’avis négatif
status-unlike-failed = Impossible de retirer le « J’aime »
status-explicit-skipped = Titre explicite ignoré
status-no-clean-tracks = Aucun titre sans contenu explicite à lire
status-signed-in = Connecté
status-signed-out = Déconnecté
status-switched-channel = Passage à { $name }
status-skipped-track = « { $title } » ignoré : { $reason }
status-track-failed = Impossible de lire « { $title } » : { $reason }
status-track-from-device = « { $title } » repris depuis votre autre appareil. Appuyez sur Lecture pour continuer.
status-track-disconnected = Connexion perdue pendant « { $title } ». Appuyez sur Lecture pour reprendre.
