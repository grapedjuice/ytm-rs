{
  "id": "minimalism-music",
  "name": "Minimalism Music",
  "creators": ["notacoderlols"],
  "blurb": "An Apple Music-inspired look: very large SF Pro lyrics, sung lines that vanish, a flat 75% for the lines ahead and a still, dimmed blurred cover behind.",
  "source": "Better Lyrics: notacoderlols/Minimalisic-Music 1.0.0",
  "background": {
    "mode": "cover_static",
    "np_dim": 0.5
  },
  "lyrics": {
    "weight": "semibold",
    "font": "SF Pro Display",
    "font_rem": [[0, 3.0], [1400, 4.0], [1600, 5.0], [1800, 6.0]],
    "line_padding_rem": 0.5,
    "padding_inline": [20, 10],
    "past": [[0.0, 0.0]],
    "upcoming": [[0.75, 0.0]],
    "opacity_transition": { "frac": 0.5, "secs": 0.0, "delay": 0.166 },
    "blur_transition": { "frac": 0.3333, "secs": 0.0, "delay": 0.4 },
    "hover_reveal": true,
    "hover_scale": 1.01,
    "letter_wave": { "on": false },
    "wobble": false,
    "glow_alpha": 0.0,
    "long_glow_alpha": 1.0,
    "background_em": 1.0,
    "romanization_rem": 1.6,
    "romanization_pill": false,
    "translation_rem": 1.6,
    "instrumental": "dots"
  },
  "cover": {
    "radius": 10,
    "size_vh": 0.5,
    "outline": [1, 0.1]
  },
  "chrome": {
    "hide_volume": true,
    "progress_color": "white",
    "progress_radius": 100
  },
  "app": {
    "font": "SF Pro Display",
    "hide_scrollbars": true
  }
}
