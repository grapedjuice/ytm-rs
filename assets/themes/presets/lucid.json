{
  "id": "lucid",
  "name": "Lucid",
  "creators": ["drago-oo"],
  "blurb": "Minimal frosted glass with bold lyrics that blur in a cascade as they approach and dissolve once sung, over an animated backdrop on every page.",
  "source": "Better Lyrics: drago-oo/lucid-theme 1.3.0",
  "accent": "#ffffff",
  "background": {
    "mode": "kawarp",
    "np_dim": 0.68,
    "intensity": 1.0,
    "speed": 3.33,
    "saturation": 1.5,
    "reactive": 2.0,
    "audio_speed": 8.0,
    "layer": { "opacity": 0.3 }
  },
  "lyrics": {
    "font": "SF Pro Display",
    "font_rem": [[0, 3], [1279, 5]],
    "dim_alpha": 0.2,
    "past": [[0, 5]],
    "upcoming": [[1, 2], [1, 3.5], [1, 5], [1, 6.5], [1, 8], [1, 9.5]],
    "opacity_transition": { "frac": 0, "secs": 0.4, "delay": 0 },
    "blur_transition": { "frac": 0, "secs": 0.4, "delay": 0 },
    "rest_scale": 0.95,
    "active_scale": 1.0,
    "scale_secs": 0.4,
    "wobble": false,
    "glow_alpha": 0.0,
    "long_glow_alpha": 1.0,
    "glow_rem": 1.0,
    "background_em": 0.65,
    "romanization_rem": 2.0,
    "romanization_alpha": 0.2,
    "romanization_pill": false,
    "translation_rem": 2.0,
    "translation_alpha": 0.2,
    "scroll_secs": 0.8,
    "scroll_ease": [0.45, 0.0, 0.15, 1.0],
    "scroll_offset": 0.6,
    "early_scroll": 0.67
  },
  "cover": {
    "radius": 16,
    "size_vh": 0.55,
    "shadow": 0.4,
    "shadow_blur": 50,
    "shadow_offset": 20
  },
  "now_playing": { "tabs": "strip" },
  "chrome": {
    "bar_color": "#141414",
    "progress_at": "top",
    "progress_px": 8,
    "progress_color": "white",
    "progress_radius": 60,
    "progress_thumb": false,
    "play_button": "bare"
  },
  "app": {
    "font": "SF Pro Display",
    "page_bg": "same",
    "page_dim": 0.68,
    "sidebar": "glass",
    "sidebar_alpha": 0.0,
    "sidebar_border": 0.1,
    "bar_alpha": 0.2,
    "chip": "pill",
    "chip_radius": 30,
    "card_radius": 12,
    "thumb_radius": 10,
    "panel_radius": 24,
    "menu_radius": 16,
    "menu_border": 0.1,
    "search_radius": 12,
    "search_alpha": 0.0,
    "search_border": 0.1,
    "hide_scrollbars": true,
    "frost": true
  }
}
