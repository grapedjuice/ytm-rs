{
  "id": "dynamic-background",
  "name": "Dynamic Background",
  "creators": ["chengggit"],
  "blurb": "An animated cover backdrop across the whole app with frosted glass; every line but the one being sung is blurred, and sung words glow.",
  "source": "Better Lyrics: chengggit/YouTube-Music-Dynamic-Theme 4.0.0",
  "accent": "#ffffff",
  "background": {
    "mode": "kawarp",
    "np_dim": 0.75,
    "page_dim": 0.75,
    "intensity": 1,
    "speed": 6.66,
    "saturation": 1.5,
    "reactive": 0,
    "audio_speed": 0,
    "crossfade_secs": 1.5,
    "beat_threshold": 0.75,
    "auto_dim": 0.3,
    "blur_passes": 10,
    "dither": 0.008,
    "video_backdrop": true
  },
  "lyrics": {
    "font": "Inter",
    "weight": "semibold",
    "font_rem": [[0, 4.0]],
    "past": [[0.4, 6]],
    "upcoming": [[1, 6]],
    "opacity_transition": { "frac": 0, "secs": 0.6, "delay": 0 },
    "blur_transition": { "frac": 0, "secs": 0.8, "delay": 0 },
    "hover_reveal": true,
    "glow_alpha": 1,
    "long_glow_alpha": 1,
    "scroll_ease": [0.42, 0, 0.58, 1],
    "pre_sharp_secs": 0.5,
    "scroll_transition": { "frac": 0, "secs": 0.35, "delay": 0 },
    "resume_look": [12, 0.1, 0],
    "scroll_opacity_transition": {"frac": 0, "secs": 0.2, "delay": 0}
  },
  "cover": { "radius": 20, "shadow": 0.2, "shadow_blur": 8, "shadow_offset": 4, "max_px": 400, "fullscreen": {
      "corner_layout": true
    }, "open_scale": 0.2, "open_secs": 0.75,
    "open_slide": 0.6,
    "open_fade": true,
    "overlay_gradient": [0.5, 0] },
  "now_playing": { "title_align": "left", "title_px": 25, "artist_px": 20, "title_max_px": 500, "fullscreen_panel_frac": 0.4, "header_autohide": true },
  "chrome": {},
  "app": {
    "font": "Inter",
    "page_bg": "same",
    "bar_alpha": 0,
    "chip": "tonal",
    "chip_radius": 12,
    "card_radius": 20,
    "thumb_radius": 8,
    "panel_radius": 24,
    "menu_radius": 24,
    "text_dim": "#b3b3b3",
    "search_radius": 12,
    "search_alpha": 0.1,
    "hide_scrollbars": true,
    "controls": { "hover_scale": 1.2, "play_hover_scale": 1.2 },
    "nav_item": { "hover": 0.1, "selected": 0.1, "width": 256 },
    "chip_look": { "fill": 0.1, "hover": 0.1, "selected_fill": "white", "selected_alpha": 0.2, "selected_text": "accent" },
    "row_look": { "height": 54, "thumb_px": 38, "hover": 0.1, "hover_menu": true },
    "menu_look": { "hover": 0.1, "alpha": 0, "shadow": [4, 8, 0.2] },
    "toast_look": { "alpha": 0, "radius": 12 },
    "card_look": { "image_zoom": 0.01, "play_px": 40, "play_alpha": 0.6, "play_hover_scale": 1.2 },
    "search_look": { "accent_icon": true, "drop_radius": 12 },
    "header_image_alpha": 0.8,
    "header_gradient": [0.5, 0],
    "np_open_secs": 0.65,
    "glass": { "top_bar": [8, 1, 1], "menu": [8, 1, 1], "search_drop": [8, 1, 1], "toast": [8, 1, 1], "dialog": [8, 1, 1] },
    "ui_fade_secs": 0.4
  }
}
