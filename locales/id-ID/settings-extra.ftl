### Options and descriptions used in Settings.

extra-renderer-desc = Pakai { $api } (wgpu), bukan OpenGL. Memakan memori sekitar tiga kali lipat dan berguna kalau tampilan OpenGL rusak. Otomatis balik ke OpenGL kalau { $api } nggak bisa jalan.
extra-channel-release-desc = Rilis Stable siap dipakai sehari-hari. Build Nightly masih eksperimental dan bisa error.
extra-theme-accessible-name = Tema: { $name }
extra-built-in = Bawaan
extra-theme-author = oleh { $name }
extra-theme-source = Dari { $source }
extra-system-shortcuts = Pintasan seluruh sistem
extra-system-shortcuts-desc = Pintasan ini tetap jalan saat aplikasi lain lagi di depan, atau saat jendela diminimalkan atau ada di tray.
extra-shortcut-failed = Pintasan itu gagal disimpan
extra-shortcut-missing = Nggak ada tombol yang terdeteksi. Mungkin pintasan itu dipakai aplikasi lain, coba yang lain.
extra-shortcut-hold = Tekan bareng { $keys } juga, biar ngetik di aplikasi lain nggak keganggu.
extra-shortcut-occupied = Udah dipakai buat “{ $command }”.
extra-shortcut-press = Tekan pintasan barunya.
extra-shortcut-wait = Nunggu tombol ditekan
extra-shortcuts-wayland = Wayland nggak ngizinin aplikasi memantau tombol di latar belakang. Pakai pintasan media dari desktop kamu buat mengontrol ytm-rs.
extra-shortcuts-blocked = Sistem nggak ngizinin ytm-rs memasang pintasan.
extra-unavailable-here = Nggak tersedia di sini
extra-shortcut-app-conflict = Mungkin dipakai aplikasi lain
extra-reset = Reset
