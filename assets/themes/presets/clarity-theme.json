{
  "id": "clarity-theme",
  "name": "Clarity",
  "creators": ["Al Farrizi"],
  "blurb": "Clean glassmorphism with heavy Figtree lyrics that slide away once sung, and a floating glass player bar with a spinning vinyl peeking out of the thumbnail.",
  "source": "Better Lyrics: AlFarrizi-Studio/Clarity-Theme 1.0.5",
  "accent": "#1db954",
  "background": { "mode": "cover_static" },
  "lyrics": {
    "font": "Figtree",
    "weight": "bold",
    "font_rem": [[0, 3.3]],
    "fullscreen_scale": 1.818,
    "line_height": 1.25,
    "line_padding_rem": 1.8,
    "letter_spacing_em": 0.02,
    "past": [[0, 0]],
    "opacity_transition": { "frac": 0, "secs": 1.6, "delay": 0 },
    "wobble_secs": 2.5,
    "line_exit": [-200, 1.6],
    "fullscreen_padding_rem": 3,
    "instrumental_rem": 4,
    "line_exit_by_side": true
  },
  "cover": { "radius": 20, "disc_slide_secs": 0.7 },
  "now_playing": {
    "title_align": "left",
    "video_lyrics": true,
    "video_panel_frac": [0.5, 0.6]
  },
  "chrome": {
    "player_bar": "floating",
    "bar_height": 92,
    "bar_radius": 20,
    "bar_color": "#0e0e12",
    "bar_margin": [16, 5],
    "progress_at": "bottom",
    "progress_px": 4,
    "progress_color": "white",
    "progress_thumb": true,
    "play_button": "bare",
    "disc_secs": 10,
    "bar_title_px": 14,
    "bar_title_weight": "semibold",
    "bar_byline_px": 12,
    "bar_byline_alpha": 0.7,
    "bar_shadow": [12, 40, 0.45],
    "bar_border_alpha": 0.08,
    "volume_on_hover": true,
    "bar_pad": [22, 8],
    "transport_gap": 0.85,
    "time_at": "under_transport",
    "time_weight": "medium",
    "time_alpha": 0.65,
    "thumb_px": 56,
    "thumb_radius": 4,
    "progress_track": 0.14,
    "progress_alpha": 0.96,
    "progress_thumb_px": 5
  },
  "app": {
    "sidebar": "glass",
    "sidebar_alpha": 0.55,
    "bar_alpha": 0.86,
    "bar_border": false,
    "panel_radius": 20,
    "menu_radius": 14,
    "menu_border": 0.08,
    "menu_color": "#0e0e12",
    "text_dim": "#b3b3b3",
    "search_alpha": 0.55,
    "search_border": 0.08,
    "search_look": { "max_px": 700, "color": "#0e0e12", "drop_alpha": 0.55 },
    "nav_item": { "hover": 0.12, "selected": 0.10 },
    "menu_look": { "hover": 0.12, "alpha": 0.86, "row_radius": 8, "shadow": [12, 40, 0.45] },
    "toast_look": { "secs": 1.5 },
    "tabular_digits": true,
    "glass": { "top_bar": [10, 1, 1], "bar": [28, 1.5, 1], "menu": [28, 1.5, 1], "search_drop": [24, 1.5, 1], "dialog": [28, 1.5, 1], "search": [24, 1, 1] },
