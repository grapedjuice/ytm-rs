{
  "id": "minimal",
  "name": "Minimal",
  "creators": [
    "semicolonhope"
  ],
  "blurb": "Calm line-by-line lyrics with no karaoke wipe, over a dim, unblurred cover backdrop.",
  "source": "Better Lyrics: ramansg/Minimal 3.0.5",
  "background": {
    "mode": "cover_fullbleed",
    "np_dim": 0.22
  },
  "accent": "#ffffff",
  "lyrics": {
    "font": "Google Sans Flex",
    "weight": "semibold",
    "font_rem": [
      [
        0,
        3
      ]
    ],
    "fullscreen_scale": 1.4,
    "line_height": 1.5,
    "line_padding_rem": 1.35,
    "anchor": 0.4,
    "rest_scale": 1,
    "active_scale": 1,
    "wobble": false,
    "letter_wave": {
      "on": false
    },
    "glow_alpha": 0,
    "long_glow_alpha": 0,
    "romanization_rem": 1.5,
    "romanization_alpha": 0.65,
    "romanization_pill": false,
    "translation_rem": 2,
    "translation_alpha": 0.82,
    "fill": "line",
    "dim_alpha": 1,
    "past": [
      [
        0.6,
        0
      ]
    ],
    "upcoming": [
      [
        0.15,
        0
      ]
    ],
    "opacity_transition": {
      "frac": 0,
      "secs": 0.4,
      "delay": 0
    },
    "scroll_opacity": 0.5,
    "scroll_secs": 0.7,
    "scroll_ease": [
      0.215,
      0.61,
      0.355,
      1
    ],
    "scroll_offset": 0.133
  },
  "cover": {
    "radius_pct": 0.08,
    "outline": [
      1,
      0.1
    ]
  },
  "chrome": {
    "play_button": "ghost",
    "progress_color": "white",
    "progress_thumb": false
  },
  "app": {
    "font": "Google Sans Flex",
    "page_bg": "solid",
    "bar_alpha": 0,
    "chip": "ghost",
    "search_radius": 20,
    "search_alpha": 0.1,
    "search_border": 0.1,
    "menu_radius": 13.92,
    "text_dim": "#a3a3a3"
  }
}
