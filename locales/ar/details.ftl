### App interface.

ui-podcast = بودكاست
ui-unpin-window = إيقاف التثبيت في المقدمة
ui-scroll-right = تمرير { $title } إلى اليمين
ui-scroll-left = تمرير { $title } إلى اليسار
nav-listen-again = استمع مجدداً
nav-quick-picks = اختيارات سريعة
nav-mood-genres = الحالات المزاجية والأنواع
nav-your-mixes = مكساتك
login-youtube = سجّل الدخول إلى YouTube Music
login-lyrics = جارٍ التحقق من الوصول إلى الكلمات
login-failed = فشلت نافذة تسجيل الدخول: { $error }
login-spotify-failed = فشلت نافذة تسجيل الدخول Spotify: { $error }
backend-error = فشل { $operation }: { $error }
backend-unexpected-reply = لم يستجب YouTube بشكل صحيح
backend-offline = تعذّر الوصول إلى YouTube Music. الأغاني المنزَّلة ما زالت تُشغَّل، من المكتبة › التنزيلات.
backend-offline-in-downloads = تعذّر الوصول إلى YouTube Music. الأغاني المنزَّلة ما زالت تُشغَّل.
backend-offline-proxy = تعذّر الوصول إلى YouTube Music عبر الوكيل (الإعدادات › الشبكة › الوكيل). الأغاني المنزَّلة ما زالت تُشغَّل.
backend-unreachable = تعذّر الوصول إلى YouTube Music
backend-session-expired = انتهت صلاحية تسجيل دخولك إلى YouTube. سجّل الدخول مجدداً لاستعادة مكتبتك.
backend-empty-download = لا يحتوي «{ $title }» على أغانٍ للتحميل
backend-rating = تقييم الأغنية
backend-channel-switch = جارٍ تبديل القناة
backend-move-playlist = نقل في قائمة التشغيل
